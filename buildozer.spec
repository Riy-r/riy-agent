[app]
title = Riy AI Agent
package.name = riyagent
package.domain = com.riy
source.dir = .
source.include_exts = py,db
version = 4.3
requirements = python3,kivy
orientation = portrait
fullscreen = 0
android.permissions = INTERNET
android.api = 33
android.minapi = 21
android.ndk = 23b
android.archs = arm64-v8a
