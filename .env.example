# Copy this file to .env and fill in your own key.
# Never commit .env to git.
#
# Create a key at: https://platform.openai.com/api-keys
# Restart `npm start` after changing this file.

EXPO_PUBLIC_OPENAI_API_KEY=sk-your-key-here

# Recommended for anything beyond local testing: route calls through your own
# proxy so the key stays on the server. If set, the key above is ignored.
# See server/README.md.
# EXPO_PUBLIC_API_PROXY_URL=http://192.168.1.20:8787
# Only if the proxy has PROXY_TOKEN set. Must match it exactly.
# EXPO_PUBLIC_API_PROXY_TOKEN=some-long-random-string
